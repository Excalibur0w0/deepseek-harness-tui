{
  "name": "deepseek-harness-tui",
  "version": "0.2.0",
  "private": true,
  "description": "A minimal interactive terminal chat for DeepSeek Harness, mounted as a dsh profile app",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "check": "for file in packages/*/src/*.js; do node --check \"$file\" || exit 1; done"
  },
  "dependencies": {
    "@dsh-tui/chat": "workspace:*",
    "@dsh-tui/commands": "workspace:*",
    "@dsh-tui/console": "workspace:*",
    "@dsh-tui/interaction": "workspace:*",
    "@dsh-tui/transcript": "workspace:*"
  },
  "license": "MIT"
}
