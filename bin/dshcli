#!/usr/bin/env bash
# Start the dsh `tui` profile in the current directory from a deepseek-harness
# source checkout. `pnpm dsh` always runs from the checkout root, which would
# make the checkout the agent's workspace; this launcher keeps the caller's cwd
# and reproduces the same tsx source launch.
set -euo pipefail

TUI_REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

# The deepseek-harness checkout defaults to a sibling of this repository.
DSH_REPO="${DSH_REPO:-$(dirname "$TUI_REPO")/deepseek-harness}"
if [[ ! -f "$DSH_REPO/apps/cli/src/bin.ts" ]]; then
  echo "dshcli: no deepseek-harness checkout at $DSH_REPO (set DSH_REPO)" >&2
  exit 1
fi

# The bundle loads its plugins through the workspace links `pnpm install`
# creates; without them the loader cannot resolve the tui-* rows.
if [[ ! -d "$TUI_REPO/node_modules/@dsh-tui" ]]; then
  echo "dshcli: workspace packages are not linked; run \`pnpm install\` in $TUI_REPO" >&2
  exit 1
fi

# OpenTUI calls its native core through node:ffi, which needs Node >= 26.4
# built with FFI support and started with --experimental-ffi. Homebrew's Node
# is built without it, so prefer an explicit or user-installed official build.
NODE_BIN=""
for candidate in "${DSH_TUI_NODE:-}" "$HOME/.local/share/dsh-tui/node/bin/node" "$(command -v node || true)"; do
  [[ -n "$candidate" && -x "$candidate" ]] || continue
  if "$candidate" --experimental-ffi --disable-warning=ExperimentalWarning \
    --input-type=module -e "await import('node:ffi')" >/dev/null 2>&1; then
    NODE_BIN="$candidate"
    break
  fi
done
if [[ -z "$NODE_BIN" ]]; then
  echo "dshcli: no Node.js with node:ffi found (needs >= 26.4 built with FFI)." >&2
  echo "dshcli: unpack an official build from nodejs.org to ~/.local/share/dsh-tui/node, or set DSH_TUI_NODE" >&2
  exit 1
fi

export TSX_TSCONFIG_PATH="$DSH_REPO/tsconfig.json"
exec "$NODE_BIN" --experimental-ffi --disable-warning=ExperimentalWarning \
  --import "file://$DSH_REPO/node_modules/tsx/dist/esm/index.mjs" \
  "$DSH_REPO/apps/cli/src/bin.ts" --profile tui "$@"
